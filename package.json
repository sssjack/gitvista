{
  "name": "gitvista",
  "version": "0.9.8",
  "private": true,
  "description": "GitVista — 看清每一次变更",
  "author": "ChenKeXin",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "fetch:mingit": "node scripts/fetch-mingit.mjs",
    "prepackage": "node scripts/fetch-mingit.mjs",
    "prepackage:dir": "node scripts/fetch-mingit.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && node scripts/package.mjs --dir",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "postpackage": "npm run clean:artifacts",
    "postpackage:dir": "npm run clean:artifacts",
    "clean:artifacts": "node scripts/cleanup-artifacts.mjs",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "validation:run": "node scripts/validation-run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "playwright": "^1.58.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "build": {
    "appId": "cn.gitvista.desktop",
    "productName": "GitVista",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "extraResources": [{ "from": "vendor/mingit", "to": "git" }]
    },
    "portable": {
      "artifactName": "GitVista-${version}-Windows-x64.exe"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "artifactName": "GitVista-${version}-macOS-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "afterSign": "scripts/installation-manifest.mjs",
    "nsis": {
      "artifactName": "GitVista-${version}-Setup-x64.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "shortcutName": "GitVista",
      "include": "scripts/installer.nsh"
    }
  }
}
